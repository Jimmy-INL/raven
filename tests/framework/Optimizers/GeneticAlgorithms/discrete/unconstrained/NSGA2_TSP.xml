<?xml version="1.0" ?>
<Simulation verbosity="silent">
  <TestInfo>
    <name>framework/Optimizers/GeneticAlgorithms.NSGA-II_TSP</name>
    <author>MohammadAbdo</author>
    <created>2026-11-18</created>
    <classesTested>MultiObjectiveGeneticAlgorithm, NSGAII, crossovers.orderCrossover</classesTested>
    <description>
      The bi-objective traveling salesman problem on 10 cities, solved with NSGA-II.
      x1..x10 are the city at each stop of a closed tour; they share one withoutReplacement
      UniformDiscrete distribution, so every chromosome is a permutation of the cities. The two
      objectives, both minimized, are the length of the same tour on two independent maps,
      lengthA and lengthB, so short tours on one map are long on the other. orderCrossover (OX)
      and inversionMutator both keep a chromosome a permutation, so no repair is needed.
      The exact Pareto front has 17 points, from (254.3848, 369.6443) to (508.5362, 219.2863).
    </description>
    <analytic>
      travelingSalesman.py documents the exact solutions, found by enumerating all 181440 distinct
      tours of the 10 cities.
    </analytic>
  </TestInfo>

  <RunInfo>
    <WorkingDir>NSGA2_TSP</WorkingDir>
    <Sequence>optimize, print</Sequence>
    <batchSize>1</batchSize>
  </RunInfo>

  <Steps>
    <MultiRun name="optimize" re-seeding="2286">
      <Input class="DataObjects" type="PointSet">placeholder</Input>
      <Model class="Models" type="ExternalModel">tsp</Model>
      <Optimizer class="Optimizers" type="MultiObjectiveGeneticAlgorithm">GAopt</Optimizer>
      <SolutionExport class="DataObjects" type="PointSet">opt_export</SolutionExport>
      <Output class="DataObjects" type="PointSet">optOut</Output>
    </MultiRun>
    <IOStep name="print">
      <Input class="DataObjects" type="PointSet">opt_export</Input>
      <Output class="OutStreams" type="Print">opt_export</Output>
    </IOStep>
  </Steps>

  <Distributions>
    <!-- one shared withoutReplacement distribution: x1..x10 are a permutation of the 10 cities -->
    <UniformDiscrete name="cityDist">
      <lowerBound>1</lowerBound>
      <upperBound>10</upperBound>
      <strategy>withoutReplacement</strategy>
    </UniformDiscrete>
  </Distributions>

  <Optimizers>
    <MultiObjectiveGeneticAlgorithm name="GAopt" type="NSGA-II">
      <samplerInit>
        <limit>40</limit>
        <initialSeed>42</initialSeed>
        <writeSteps>every</writeSteps>
        <type>min, min</type>
      </samplerInit>
      <GAparams>
        <populationSize>40</populationSize>
        <parentSelection>tournamentSelection</parentSelection>
        <reproduction>
          <crossover type="orderCrossover">
            <crossoverProb>0.9</crossoverProb>
          </crossover>
          <mutation type="inversionMutator">
            <mutationProb>0.3</mutationProb>
          </mutation>
        </reproduction>
        <survivorSelection>rankNcrowdingBased</survivorSelection>
      </GAparams>
      <variable name="x1">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x2">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x3">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x4">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x5">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x6">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x7">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x8">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x9">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x10">
        <distribution>cityDist</distribution>
      </variable>
      <objective>lengthA, lengthB</objective>
      <TargetEvaluation class="DataObjects" type="PointSet">optOut</TargetEvaluation>
      <Sampler class="Samplers" type="MonteCarlo">MC_samp</Sampler>
    </MultiObjectiveGeneticAlgorithm>
  </Optimizers>

  <Samplers>
    <MonteCarlo name="MC_samp">
      <samplerInit>
        <limit>40</limit>
        <initialSeed>20021986</initialSeed>
      </samplerInit>
      <variable name="x1">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x2">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x3">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x4">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x5">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x6">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x7">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x8">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x9">
        <distribution>cityDist</distribution>
      </variable>
      <variable name="x10">
        <distribution>cityDist</distribution>
      </variable>
    </MonteCarlo>
  </Samplers>

  <Models>
    <ExternalModel ModuleToLoad="../../../../../AnalyticModels/optimizing/travelingSalesman.py" name="tsp" subType="">
      <variables>x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,lengthA,lengthB,lengthC</variables>
    </ExternalModel>
  </Models>

  <DataObjects>
    <PointSet name="placeholder"/>
    <PointSet name="optOut">
      <Input>x1,x2,x3,x4,x5,x6,x7,x8,x9,x10</Input>
      <Output>lengthA,lengthB</Output>
    </PointSet>
    <PointSet name="opt_export">
      <Input>trajID</Input>
      <Output>x1,x2,x3,x4,x5,x6,x7,x8,x9,x10,lengthA,lengthB,age,batchId,rank,CD,iteration,accepted</Output>
    </PointSet>
  </DataObjects>

  <OutStreams>
    <Print name="opt_export">
      <type>csv</type>
      <source>opt_export</source>
      <clusterLabel>trajID</clusterLabel>
    </Print>
  </OutStreams>
</Simulation>
